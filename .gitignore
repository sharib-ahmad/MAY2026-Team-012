# =========================
# Verdeza Git Ignore Rules
# =========================

# -------------------------
# Python / FastAPI backend
# -------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python build/package artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# -------------------------
# Environment / secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Node / React frontend
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.vite/

# -------------------------
# Editor / IDE
# -------------------------
.vscode/
.idea/
*.swp
*.swo

# -------------------------
# OS files
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# Local databases / temp files
# -------------------------
*.db
*.sqlite
*.sqlite3
tmp/
temp/

# -------------------------
# Generated test output
# -------------------------
test_matrix_output.json