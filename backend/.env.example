# backend/.env.example — placeholders only, safe to commit. Copy to .env and fill in.

# Environment: local | test | staging | production
APP_ENV=local

DATABASE_URL=postgresql+psycopg://verdeza:placeholder@localhost:5433/verdeza

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 non-space chars when APP_ENV is not 'test'.
SECRET_KEY=4c2d8e7f91a5b3c8d6e4f7a9b1c3d5e8f0a2c4b6d8e1f3a5c7b9d2e4f6a8c1b2

ACCESS_TOKEN_EXPIRE_MINUTES=480
