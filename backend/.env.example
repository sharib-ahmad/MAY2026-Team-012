# backend/.env.example — placeholders only, safe to commit. Copy to .env and fill in.

# Environment: local | test | staging | production
APP_ENV=local

DATABASE_URL=postgresql+psycopg://verdeza:verdeza@localhost:5432/verdeza

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 non-space chars when APP_ENV is not 'test'.
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=480
PILOT_TIMEZONE=Asia/Kolkata
